{
  "name": "nuxt-app",
  "version": "1.2.5",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "e2e": "vitest run --no-file-parallelism",
    "playwright": "dotenv -e .env.test playwright test",
    "test": "vitest run --no-file-parallelism && dotenv -e .env.test playwright test",
    "format": "prettier --write \"{app/components,app/composables,app/layouts,app/middleware,app/pages,app/utils,server,stores,shared,test}/**/*.{ts,vue}\"",
    "tsc": "tsc --noEmit",
    "admin": "dotenv tsx ./server/database/admin.ts"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/icon": "^2.6.3",
    "@nuxt/ui": "^4.13.1",
    "@nuxtjs/device": "^4.0.0",
    "@pinia/nuxt": "^1.0.3",
    "@vueuse/core": "^15.1.0",
    "@vueuse/nuxt": "^15.1.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "nuxt": "^4.7.0",
    "nuxt-auth-utils": "^0.6.2",
    "pinia": "^4.1.0",
    "sanitize-html": "^2.18.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "validator": "^13.15.35",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.4.0",
    "@playwright/test": "^1.65.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "@types/validator": "^13.15.10",
    "@vitest/ui": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "dotenv-cli": "^11.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "unrs-resolver@1.11.1": true,
    "@parcel/watcher@2.5.1": true,
    "@tailwindcss/oxide@4.1.12": true,
    "vue-demi@0.14.10": true,
    "esbuild@0.25.9": true,
    "esbuild@0.28.2": true,
    "sqlite3@6.0.1": true
  }
}
